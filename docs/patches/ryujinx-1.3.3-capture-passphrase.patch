+        // LDN bridge M2b: a private file rather than the log, so the passphrase never reaches the logs.
+        private static void CaptureSecurityConfig(string call, SecurityConfig config, long localCommunicationId, uint version)
+        {
+            string path = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "ldn-passphrase.txt");
+            int size = Math.Min((int)config.PassphraseSize, LdnConst.PassphraseLengthMax);
+            string passphrase = Convert.ToHexString(config.Passphrase.AsSpan()[..size]);
+
+            File.AppendAllText(path, $"{call} lcid={localCommunicationId:x16} version={version} mode={(int)config.SecurityMode} size={config.PassphraseSize} passphrase={passphrase}\n");
+
+            if (OperatingSystem.IsLinux())
+            {
+                File.SetUnixFileMode(path, UnixFileMode.UserRead | UnixFileMode.UserWrite);
+            }
+        }
